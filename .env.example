# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tinkertank_market"

# Stripe Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Set to "production" in production environment for live Stripe IDs
NEXT_PUBLIC_STRIPE_MODE="test"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_SITE_VERIFICATION=""

# Analytics and paid campaign conversion tracking
NEXT_PUBLIC_META_PIXEL_ID="481960682009897"
META_CONVERSIONS_API_ACCESS_TOKEN=""
# Optional: read-only (ads_read) system user token and ad account for the admin Sales page
META_ADS_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# Optional super admin login: unlocks Stripe billing actions (pause/resume/cancel) in /admin
SUPER_ADMIN_USERNAME=""
SUPER_ADMIN_PASSWORD=""
